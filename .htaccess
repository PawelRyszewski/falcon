php_value log_errors 1
php_value error_log /home/klient.dhosting.pl/mekros/ai.skpkj.pl/logs/php/php_errors.log

RewriteEngine On
RewriteRule ^ai-materials/pages_import\.php$ - [L]

ErrorDocument 404 /blad404/28

RemoveHandler .html
Options All -Indexes

RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule .* https://skpkj.eko-dom.warszawa.pl/%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^img/(.*)$ img/$1 [L]
RewriteRule ^uploads/(.*)$ uploads/$1 [L]
RewriteRule ^ai-materials/uploads/(.*)$ ai-materials/uploads/$1 [L]
RewriteRule ^js/(.*)$ js/$1 [L]
RewriteRule ^utils/(.*)$ utils/$1 [L]

RewriteRule ^styles/(.*)$ styles/$1 [L]
RewriteRule ^robots.txt$ https://skpkj.eko-dom.warszawa.pl/robots.txt [L]
RewriteRule ^mail.php$ https://skpkj.eko-dom.warszawa.pl/mail.php [L]


RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^([a-zA-Z0-9-_\.]+)$ /index.php?par1=$1 [QSA,L]
RewriteRule ^([a-zA-Z0-9-_\.]+)/([a-zA-Z0-9-_,.]+)$ /index.php?par1=$1&par2=$2 [QSA,L]
RewriteRule ^([a-zA-Z0-9-_\.]+)/([a-zA-Z0-9-_,.]+)/([a-zA-Z0-9-_,.]+)$ /index.php?par1=$1&par2=$2&par3=$3 [QSA,L]

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault "access plus 1 month"
	ExpiresByType text/html "access plus 1 seconds"
	ExpiresByType image/gif "access plus 30 days"
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/jpg "access plus 30 days"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType text/css "access plus 30 days"
	ExpiresByType text/javascript "access plus 30 days"
	ExpiresByType application/javascript "access plus 30 days"
	ExpiresByType application/x-javascript "access plus 30 days"
	ExpiresByType text/xml "access plus 60 minutes"
</IfModule>



ErrorDocument 404 https://skpkj.eko-dom.warszawa.pl/blad404/28

AuthType Basic  
AuthName "restricted area"  
AuthUserFile pass.htpasswd 
require valid-user


