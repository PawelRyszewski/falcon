RewriteEngine On

Options All -Indexes
RewriteRule ^utils/(.*)$ utils/$1 [L]
RewriteRule ^uploads$ uploads [L]
RewriteRule ^uploads/(.*)$ uploads/$1 [L]
RewriteRule ^api/(.*)$ api/$1 [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^([a-zA-Z0-9-_\.]+)$ /admin/index.php?par1=$1
RewriteRule ^([a-zA-Z0-9-_\.]+)/([a-zA-Z0-9-_,.]+)$ /admin/index.php?par1=$1&par2=$2
RewriteRule ^([a-zA-Z0-9-_\.]+)/([a-zA-Z0-9-_,.]+)/([a-zA-Z0-9-_,.]+)$ /admin/index.php?par1=$1&par2=$2&par3=$3
